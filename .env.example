# Supabase Dashboard -> Connect -> Connection string -> URI
# Use the session pooler connection string for server deployments.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?sslmode=require

# Optional; defaults to 3000.
PORT=3000

# Use a long, random value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800